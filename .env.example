# Nebius Token Factory (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Tavily (https://app.tavily.com)
TAVILY_API_KEY=

# Optional: pin exact model IDs. If empty, BidScout resolves them from /v1/models.
MODEL_NANO=
MODEL_SUPER=
MODEL_ULTRA=

# Optional: demo mode replays cached responses so the golden path never fails.
# auto = use cache when keys are missing or a live call fails; live = never replay; replay = cache only
DEMO_MODE=auto

DATABASE_PATH=bidscout.db
CORS_ORIGINS=http://localhost:3000
